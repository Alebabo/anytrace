VITE_SITE_URL=http://localhost:8080
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_TWITTER_SCRAPE_URL=http://localhost:9000/run-twitter

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-key
TWITTER_PROVIDER=tweetapi
TWITTER_STATE_BACKEND=supabase
TWITTER_LOCAL_DB_PATH=backend/local_data/twitter_state.db
TWEETAPI_KEY=your-tweetapi-key
TWEETAPI_BASE_URL=https://api.tweetapi.com/tw-v2
TWEETAPI_PAGE_SIZE=100
TWEETAPI_MAX_PAGES=3
TWITTER_REQUEST_TIMEOUT_SECONDS=30

TWITTER_USERNAME=your-x-username
TWITTER_PASSWORD=your-x-password
TWITTER_VERIFICATION=your-x-verification
TWITTER_MAX_SCROLLS=60
TWITTER_SNAPSHOT_MAX_ROWS=100

TWITTER_USE_CHROME_SESSION=1
TWITTER_CHROME_USER_DATA_DIR=C:\Users\User\AppData\Local\Google\Chrome\User Data
TWITTER_CHROME_PROFILE=Default
